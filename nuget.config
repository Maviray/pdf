<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Every package comes from nuget.org, whatever feeds a machine has configured. One mapped source keeps
    restores the same everywhere and satisfies central package management (no NU1507).
    Publishing pushes to GitHub Packages by URL, so it doesn't need a source here.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
